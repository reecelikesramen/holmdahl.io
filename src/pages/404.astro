---
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout title="Page not found" description="This page doesn't exist." noindex>
  <div class="flex flex-1 flex-col justify-center items-center text-center gap-4">
    <h1 class="text-3xl font-bold m-0 text-primary-color">404</h1>
    <p class="text-lg text-secondary-color">This page doesn't exist.</p>
    <a href="/" class="rounded-lg px-4 py-1.5 text-primary-color bg-tertiary-color font-medium text-base no-underline hover:no-underline">Go home</a>
  </div>
</MainLayout>
