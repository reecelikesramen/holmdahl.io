---
import { Picture } from 'astro:assets';
import profileImage from '@/assets/profile.png';

const size = 106;

export interface Props {
  alt: string;
  title?: string;
}

const { 
  alt, 
  title, 
} = Astro.props;
---

<Picture 
  src={profileImage}
  alt={alt}
  title={title}
  width={size}
  height={size}
  class="profile-image"
  draggable="false"
  formats={['avif', 'webp']}
  densities={[1, 2, 3]}
  fallbackFormat="jpg"
  loading="eager"
  fetchpriority="high"
/>
