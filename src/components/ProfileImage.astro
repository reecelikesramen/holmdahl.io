---
import { Picture } from 'astro:assets';
import { ProfileImageWrapper } from './ProfileImageWrapper.tsx';
import profileImage from '@/assets/profile.png';

const size = 300;

export interface Props {
  alt: string;
  title?: string;
}

const { 
  alt, 
  title, 
} = Astro.props;
---

<ProfileImageWrapper 
  width={size} 
  height={size}
  client:media="(pointer: fine)"
>
  <Picture 
    src={profileImage}
    alt={alt}
    title={title}
    width={size}
    height={size}
    class="w-full h-full object-cover select-none"
    draggable="false"
    formats={['avif', 'webp']}
    widths={[300, 450, 600, 900, 1200]}
    sizes="(min-width: 48rem) 720px, 100vw"
    fallbackFormat="jpg"
    loading="eager"
    fetchpriority="high"
  />
</ProfileImageWrapper> 