/*
    Content-Security-Policy: script-src 'self' 'unsafe-inline' https://holmdahl.io https://preview.holmdahl.io https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com; connect-src 'self' https://holmdahl.io https://preview.holmdahl.io https://www.google-analytics.com; img-src 'self' https://holmdahl.io https://preview.holmdahl.io https://www.google-analytics.com data:; font-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
    Referrer-Policy: strict-origin-when-cross-origin

# clide install scripts — serve as readable text (so `curl | sh` users can inspect first)
/clide/*
    Content-Type: text/plain; charset=utf-8
    Cache-Control: public, max-age=300

# WebTracer demo: WASM threads need SharedArrayBuffer, which needs cross-origin isolation.
# require-corp means every subresource must be same-origin, so this page loads no external fonts or scripts.
/projects/webtracer/demo
/projects/webtracer/demo/*
    ! Content-Security-Policy
    Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'
    Cross-Origin-Opener-Policy: same-origin
    Cross-Origin-Embedder-Policy: require-corp
